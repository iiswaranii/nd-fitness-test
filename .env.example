# Copy this file to .env.local and fill in the values (see README.md)

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# Set to "true" to try the app without Supabase. OTP code is 123456 in demo mode.
VITE_DEMO_AUTH=false

# Phone notifications (free Web Push). Public key only; the private key goes in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=

# Phone-only: in production the app asks people to install it (Add to Home Screen) before signing in.
# Set to "false" only while testing in a laptop browser.
VITE_REQUIRE_INSTALL=true

# Lets admins open the app on a laptop (members still need their phone). Set "false" to block laptops completely.
VITE_ALLOW_DESKTOP_ADMIN=true
